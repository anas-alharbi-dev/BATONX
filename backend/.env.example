# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (local PostgreSQL) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://localhost:5432/vyra

# --- Frontend origin(s) allowed to call the API ---
# Canonical local dev: frontend on http://localhost:3010, backend on
# http://localhost:8000 — use localhost consistently for normal local
# verification (do not mix a 127.0.0.1 frontend with a localhost backend,
# or vice versa, when testing auth). :3000 stays listed for a plain
# `next dev` with no explicit port. The 127.0.0.1 variants are kept only as
# fallback compatibility, not the documented/expected setup.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3010,http://127.0.0.1:3000,http://127.0.0.1:3010
# Phase P-2: session/CSRF cookie auth needs the frontend's origin(s) trusted
# for CSRF too (Django checks Origin against this on every unsafe method).
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3010,http://127.0.0.1:3000,http://127.0.0.1:3010

# --- AI service (server-side only; never exposed to the browser) ---
ANTHROPIC_API_KEY=
VYRA_MODEL=claude-sonnet-5
VYRA_AI_TIMEOUT_SECONDS=60
